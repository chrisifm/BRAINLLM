<meta seo title="BRAINLLM-keyed" description="js-framework-benchmark keyed implementation written in BRAINLLM." canonical="/">
<script>
  import buildData from '../lib/build-data.jsbrain'
  import ActionButton from '../ui/action-button.brain'

  let rows = sig([])
  let selected = sig(0)
  let nextId = 1

  const make = (count) => {
    const data = buildData(count, nextId)
    nextId += count
    return data
  }

  const run = () => { rows = make(1000) }
  const runLots = () => { rows = make(10000) }
  const add = () => { rows = [...rows, ...make(1000)] }
  const update = () => {
    rows = rows.map((r, i) => i % 10 === 0 ? { ...r, label: r.label + ' !!!' } : r)
  }
  const clear = () => { rows = [] }
  const swapRows = () => {
    if (rows.length > 998) rows = rows.with(1, rows[998]).with(998, rows[1])
  }
  const select = (id) => { selected = id }
  const remove = (id) => { rows = rows.filter(r => r.id !== id) }
</script>
<main class="container">
  <div class="jumbotron">
    <div class="row">
      <div class="col-md-6">
        <h1>BRAINLLM-keyed</h1>
      </div>
      <div class="col-md-6">
        <div class="row">
          <ActionButton id="run" text="Create 1,000 rows" on:press={run} />
          <ActionButton id="runlots" text="Create 10,000 rows" on:press={runLots} />
          <ActionButton id="add" text="Append 1,000 rows" on:press={add} />
          <ActionButton id="update" text="Update every 10th row" on:press={update} />
          <ActionButton id="clear" text="Clear" on:press={clear} />
          <ActionButton id="swaprows" text="Swap Rows" on:press={swapRows} />
        </div>
      </div>
    </div>
  </div>
  <table class="table table-hover table-striped test-data">
    <tbody>
      {#each rows as r (r.id)}
        <tr class:danger={selected === r.id}>
          <td class="col-md-1">{r.id}</td>
          <td class="col-md-4"><a role="button" on:click={select(r.id)}>{r.label}</a></td>
          <td class="col-md-1"><a role="button" on:click={remove(r.id)} aria-label="Remove"><span class="glyphicon glyphicon-remove" aria-hidden="true"></span></a></td>
          <td class="col-md-6"></td>
        </tr>
      {/each}
    </tbody>
  </table>
  <span class="preloadicon glyphicon glyphicon-remove" aria-hidden="true"></span>
</main>
