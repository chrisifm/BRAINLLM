<meta props="ttl:str='To do'">

<script>
  let its = sig([])
  let drft = sig('')
  let flt = sig('all')
  let nid = 1
  let vis = drv(() => flt === 'done' ? its.filter(i => i.dn) : flt === 'open' ? its.filter(i => !i.dn) : its)
  let rem = drv(() => its.filter(i => !i.dn).length)
  const add = () => {
    if (drft.trim() === '') return
    its = [...its, { id: nid++, txt: drft.trim(), dn: false }]
    drft = ''
  }
  const tgl = (id) => { its = its.map(i => i.id === id ? { ...i, dn: !i.dn } : i) }
  const rm = (id) => { its = its.filter(i => i.id !== id) }
</script>

<section>
  <h2>{ttl}</h2>
  <form on:submit={add}><input bind:value={drft} /><button>Add</button></form>
  <ul>
    {#each vis as i (i.id)}
      <li class:done={i.dn}>
        <input type="checkbox" checked={i.dn} on:change={tgl(i.id)} />
        {i.txt} <button on:click={rm(i.id)}>×</button>
      </li>
    {:empty}<li>Nothing here.</li>
    {/each}
  </ul>
  <footer>{rem} left <button on:click={flt = 'all'}>All</button> <button on:click={flt = 'open'}>Open</button> <button on:click={flt = 'done'}>Done</button></footer>
</section>
