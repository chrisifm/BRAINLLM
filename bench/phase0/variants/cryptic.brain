<meta props="p01:str='To do'">

<script>
  let t01 = sig([])
  let t02 = sig('')
  let t03 = sig('all')
  let t04 = 1
  let t05 = drv(() => t03 === 'done' ? t01.filter(x => x.f2) : t03 === 'open' ? t01.filter(x => !x.f2) : t01)
  let t06 = drv(() => t01.filter(x => !x.f2).length)
  const f01 = () => {
    if (t02.trim() === '') return
    t01 = [...t01, { f0: t04++, f1: t02.trim(), f2: false }]
    t02 = ''
  }
  const f02 = (k) => { t01 = t01.map(x => x.f0 === k ? { ...x, f2: !x.f2 } : x) }
  const f03 = (k) => { t01 = t01.filter(x => x.f0 !== k) }
</script>

<section>
  <h2>{p01}</h2>
  <form on:submit={f01}><input bind:value={t02} /><button>Add</button></form>
  <ul>
    {#each t05 as x (x.f0)}
      <li class:done={x.f2}>
        <input type="checkbox" checked={x.f2} on:change={f02(x.f0)} />
        {x.f1} <button on:click={f03(x.f0)}>×</button>
      </li>
    {:empty}<li>Nothing here.</li>
    {/each}
  </ul>
  <footer>{t06} left <button on:click={t03 = 'all'}>All</button> <button on:click={t03 = 'open'}>Open</button> <button on:click={t03 = 'done'}>Done</button></footer>
</section>
