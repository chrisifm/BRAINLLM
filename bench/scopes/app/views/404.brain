<meta seo title="Page not found" description="The page you are looking for does not exist or was moved. Go back to the home page to keep browsing." robots="noindex">

<main class="page">
  <h1>Page not found</h1>
  <p>The address may be mistyped, or the page was moved or deleted.</p>
  <p><a href="/">Back to the home page</a></p>
</main>

<style>
  .page { max-width: 60ch; margin: 0 auto; padding: var(--space-6) var(--space-4); display: grid; gap: var(--space-3); text-align: center; }
  p { margin: 0; color: var(--muted); }
</style>
