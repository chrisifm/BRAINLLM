<meta props="title:str text:str action:obj?">

<div class="empty">
  <p class="title">{title}</p>
  <p>{text}</p>
  {#if action}<a href={action.href}>{action.label}</a>{/if}
</div>

<style>
  .empty { display: grid; justify-items: center; gap: var(--space-2); padding: var(--space-5) var(--space-4); text-align: center; border: 1px dashed var(--line); border-radius: var(--radius-lg); }
  p { margin: 0; color: var(--muted); }
  .title { color: var(--fg); font-weight: 600; }
  a { color: var(--accent); font-weight: 600; }
</style>
