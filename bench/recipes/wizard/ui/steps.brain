<meta props="steps:list current:num">

<ol class="steps" aria-label="Progress">
  {#each steps as s, i (s.id)}
    <li class:done={i < current} class:now={i === current} aria-current={i === current ? 'step' : null}>
      <span class="n" aria-hidden="true">{i + 1}</span> {s.label}{#if i < current}<span class="sr"> (done)</span>{/if}
    </li>
  {/each}
</ol>

<style>
  .steps { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-3); }
  li { display: flex; align-items: center; gap: var(--space-2); color: var(--muted); }
  li.now { color: var(--fg); font-weight: 600; }
  li.done { color: var(--ok); }
  .n { display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; border: 1px solid var(--line); background: var(--surface); font-size: .85rem; }
  li.now .n { color: var(--on-accent); background: var(--accent); border-color: var(--accent); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
