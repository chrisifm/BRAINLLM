<meta props="busy:bool=false error:str=''" emits="finish:obj">

<script>
  import Steps from '../ui/steps.brain'

  const steps = [{ id: 'account', label: 'Account' }, { id: 'plan', label: 'Plan' }, { id: 'review', label: 'Review' }]
  const plans = [{ value: 'free', label: 'Free' }, { value: 'pro', label: 'Pro ($29 per month)' }, { value: 'team', label: 'Team ($79 per month)' }]
  let step = sig(0)
  let data = sig({ name: '', email: '', plan: '' })
  let errs = sig({})
  let box = ref()
  // the rules of each step; only the current step is checked when moving forward
  const problems = (n) => {
    const e = {}
    if (n === 0) {
      if (!data.name.trim()) e.name = 'Enter your name'
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(data.email)) e.email = 'Enter a valid email'
    }
    if (n === 1 && !data.plan) e.plan = 'Choose a plan'
    return e
  }
  const next = async () => {
    errs = problems(step)
    if (Object.keys(errs).length) {
      await tick()
      const bad = box.querySelector('[aria-invalid="true"]')
      if (bad) bad.focus()
      return
    }
    step = step + 1
  }
  const back = () => {
    errs = {}
    step = step - 1
  }
  const planLabel = drv(() => (plans.find((p) => p.value === data.plan) || { label: '' }).label)
</script>

<section class="wizard" aria-labelledby="wizard-title" bind:ref={box}>
  <h2 id="wizard-title">Set up your workspace</h2>
  <Steps steps={steps} current={step} />
  {#if step === 0}
    <div class="fields">
      <Input label="Your name" autocomplete="name" bind:value={data.name} error={errs.name} />
      <Input label="Work email" type="email" autocomplete="email" bind:value={data.email} error={errs.email} />
    </div>
  {:else if step === 1}
    <div class="fields">
      <Select label="Plan" placeholder="Choose a plan" options={plans} bind:value={data.plan} error={errs.plan} />
    </div>
  {:else}
    <dl class="review">
      <dt>Name</dt><dd>{data.name}</dd>
      <dt>Email</dt><dd>{data.email}</dd>
      <dt>Plan</dt><dd>{planLabel}</dd>
    </dl>
  {/if}
  {#if error}<p class="err" role="alert">{error}</p>{/if}
  <div class="actions">
    {#if step > 0}<Button variant="ghost" disabled={busy} on:click={back}>Back</Button>{/if}
    {#if step < steps.length - 1}
      <Button on:click={next}>Next</Button>
    {:else}
      <Button busy={busy} on:click={emit('finish', data)}>Finish</Button>
    {/if}
  </div>
</section>

<style>
  .wizard { display: grid; gap: var(--space-4); padding: var(--space-5); background: var(--glass); border: 1px solid var(--glass-edge); border-radius: var(--radius-lg); box-shadow: var(--shadow); }
  h2 { margin: 0; font-size: 1.3rem; }
  .fields { display: grid; gap: var(--space-3); }
  .review { display: grid; grid-template-columns: max-content 1fr; gap: var(--space-2) var(--space-4); margin: 0; }
  dt { color: var(--muted); }
  dd { margin: 0; }
  .actions { display: flex; justify-content: flex-end; gap: var(--space-2); }
  .err { margin: 0; color: var(--bad); }
</style>
