<meta seo title="Team" description="The members of your workspace: rename them or remove their access." robots="noindex">

<script>
  import ConfirmDialog from '../comp/confirm-dialog.brain'
  import RenameDialog from '../comp/rename-dialog.brain'

  // demo data: replace with a resource() over an api() endpoint and call it in rename/remove
  let members = sig([{ id: 1, name: 'Ana Ruiz', role: 'Owner' }, { id: 2, name: 'Bruno Diaz', role: 'Editor' }, { id: 3, name: 'Carla Gomez', role: 'Viewer' }])
  let notice = sig('')
  const rename = (m) => async (name) => {
    if (members.some((x) => x.id !== m.id && x.name === name)) throw { errors: { name: 'Another member already has that name' } }
    members = members.map((x) => (x.id === m.id ? { ...x, name } : x))
    notice = 'Renamed to ' + name + '.'
  }
  const remove = (m) => {
    members = members.filter((x) => x.id !== m.id)
    notice = m.name + ' was removed.'
  }
</script>

<main class="page">
  <h1>Team</h1>
  <p class="notice" role="status">{notice}</p>
  <ul class="members">
    {#each members as m (m.id)}
      <li>
        <span class="name">{m.name}</span>
        <span class="role">{m.role}</span>
        <RenameDialog name={m.name} save={rename(m)} />
        <ConfirmDialog label="Remove" title={'Remove ' + m.name + '?'} message={m.name + ' loses access to the workspace at once.'} confirmLabel="Remove" danger={true} on:confirm={remove(m)} />
      </li>
    {:empty}
      <li class="none">No members left. Invite someone to start collaborating.</li>
    {/each}
  </ul>
</main>

<style>
  .page { max-width: 48rem; margin: 0 auto; padding: var(--space-5) var(--space-4); display: grid; gap: var(--space-3); }
  .notice { margin: 0; min-height: 1.4em; color: var(--muted); }
  .members { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  li { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); padding: var(--space-3); background: var(--glass); border: 1px solid var(--glass-edge); border-radius: var(--radius); }
  .name { font-weight: 600; margin-right: auto; }
  .role { color: var(--muted); }
  .none { color: var(--muted); }
</style>
