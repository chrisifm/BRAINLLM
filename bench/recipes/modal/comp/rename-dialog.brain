<meta props="label:str='Rename' name:str save:fn">

<script>
  // save(newName) returns a promise; throwing { errors: { name: '…' } } keeps the dialog open with the message
  let d = ref()
  let f = form({ name: 'str!<=60' }, {
    init: { name },
    submit: async (v) => {
      await save(v.name.trim())
      d.close()
    },
  })
  const open = () => {
    f.reset({ name })
    d.open()
  }
</script>

<button type="button" class="trigger" on:click={open}>{label}</button>
<Dialog title={'Rename ' + name} bind:api={d}>
  <form on:submit={f.submit}>
    <Input label="New name" bind:value={f.v.name} error={f.err.name} />
    {#if f.error}<p class="err" role="alert">{f.error}</p>{/if}
    <div class="footer">
      <Button variant="ghost" on:click={d.close()}>Cancel</Button>
      <Button type="submit" busy={f.busy}>Save</Button>
    </div>
  </form>
</Dialog>

<style>
  .trigger { font: inherit; padding: var(--space-1) var(--space-3); border: 1px solid var(--line); border-radius: var(--radius-sm); color: var(--fg); background: var(--surface); cursor: pointer; }
  .trigger:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  form { display: grid; gap: var(--space-3); }
  .footer { display: flex; justify-content: flex-end; gap: var(--space-2); }
  .err { margin: 0; color: var(--bad); }
</style>
