<meta props="label:str title:str message:str confirmLabel:str='Confirm' danger:bool=false" emits="confirm" expose="open">

<script>
  // a trigger button that opens a modal asking for confirmation; `confirm` is emitted only on the confirm button
  let d = ref()
  const open = () => d.open()
  const yes = () => {
    d.close()
    emit('confirm')
  }
</script>

<button type="button" class="trigger" class:danger={danger} on:click={open}>{label}</button>
<Dialog title={title} bind:api={d}>
  <p>{message}</p>
  <div slot="footer" class="footer">
    <Button variant="ghost" on:click={d.close()}>Cancel</Button>
    <Button variant={danger ? 'danger' : 'primary'} on:click={yes}>{confirmLabel}</Button>
  </div>
</Dialog>

<style>
  .trigger { font: inherit; padding: var(--space-1) var(--space-3); border: 1px solid var(--line); border-radius: var(--radius-sm); color: var(--fg); background: var(--surface); cursor: pointer; }
  .trigger.danger { color: var(--bad); }
  .trigger:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  p { margin: 0; }
  .footer { display: flex; gap: var(--space-2); }
</style>
