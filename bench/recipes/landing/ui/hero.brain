<meta props="title:str lead:str primary:obj secondary:obj?">

<section class="hero" aria-labelledby="hero-title">
  <h1 id="hero-title">{title}</h1>
  <p class="lead">{lead}</p>
  <div class="actions">
    <a class="btn primary" href={primary.href}>{primary.label}</a>
    {#if secondary}<a class="btn" href={secondary.href}>{secondary.label}</a>{/if}
  </div>
</section>

<style>
  .hero { display: grid; justify-items: center; gap: var(--space-4); text-align: center; padding: var(--space-6) var(--space-4); }
  h1 { margin: 0; font-size: clamp(2.2rem, 6vw, 3.6rem); font-weight: 650; max-width: 20ch; }
  .lead { margin: 0; max-width: 56ch; color: var(--muted); font-size: 1.15rem; }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); }
  .btn { padding: var(--space-3) var(--space-5); border-radius: var(--radius); border: 1px solid var(--line); text-decoration: none; font-weight: 600; color: var(--fg); background: var(--surface); }
  .btn.primary { color: var(--on-accent); background: var(--accent); border-color: var(--accent); }
  .btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
