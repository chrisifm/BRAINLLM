<meta props="rows:list columns:list caption:str rowKey:str='id' empty:str='No data for this period.'">

<script>
  // columns: [{ key: 'product', label: 'Product', num?: true }] · click a header to sort, again to reverse
  let sortKey = sig('')
  let dir = sig(1)
  const sorted = drv(() => {
    if (!sortKey) return rows
    const k = sortKey
    const d = dir
    return [...rows].sort((a, b) => (a[k] > b[k] ? d : a[k] < b[k] ? -d : 0))
  })
  const sortBy = (k) => {
    if (sortKey === k) dir = -dir
    else {
      sortKey = k
      dir = 1
    }
  }
  const ariaSort = (k) => (sortKey === k ? (dir === 1 ? 'ascending' : 'descending') : 'none')
  const cell = (c, r) => (c.num ? Number(r[c.key]).toLocaleString('en-US') : r[c.key])
</script>

<div class="wrap">
  <table>
    <caption>{caption}</caption>
    <thead>
      <tr>
        {#each columns as c (c.key)}
          <th scope="col" aria-sort={ariaSort(c.key)} class:num={c.num}>
            <button type="button" on:click={sortBy(c.key)}>{c.label}<span aria-hidden="true">{sortKey === c.key ? (dir === 1 ? ' ▲' : ' ▼') : ''}</span></button>
          </th>
        {/each}
      </tr>
    </thead>
    <tbody>
      {#each sorted as r (r[rowKey])}
        <tr>
          {#each columns as c (c.key)}<td class:num={c.num}>{cell(c, r)}</td>{/each}
        </tr>
      {:empty}
        <tr><td class="empty" colspan={columns.length}>{empty}</td></tr>
      {/each}
    </tbody>
  </table>
</div>

<style>
  .wrap { overflow-x: auto; background: var(--glass); border: 1px solid var(--glass-edge); border-radius: var(--radius-lg); box-shadow: var(--shadow); }
  table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  caption { text-align: left; font-weight: 650; padding: var(--space-3) var(--space-3) var(--space-2); }
  th, td { text-align: left; padding: var(--space-2) var(--space-3); border-bottom: 1px solid var(--line); }
  .num { text-align: right; }
  th button { font: inherit; font-weight: 600; color: var(--muted); background: none; border: 0; padding: 0; cursor: pointer; }
  th button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .empty { text-align: center; color: var(--muted); padding: var(--space-5); }
</style>
