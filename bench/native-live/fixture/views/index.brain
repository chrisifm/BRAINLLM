<meta seo robots="noindex" title="Native live acceptance" description="Isolated owner-scoped native resource browser acceptance." canonical="/">
<script>
  import LivePanel from '../comp/live-panel.brain'
  let showPanel = sig(true)
</script>
<main>
  <h1>Native live acceptance</h1>
  <button id="unmount" type="button" disabled={!showPanel} on:click={showPanel = false}>Unmount live panel</button>
  {#if showPanel}<LivePanel />{:else}<p id="disposed">Live resource owner disposed.</p>{/if}
</main>
