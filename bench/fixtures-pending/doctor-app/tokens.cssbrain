:root {
  --space-1: 4px; --space-2: 8px; --space-3: 12px; --space-4: 16px; --space-5: 24px; --space-6: 32px;
  --radius: 12px;
  /* AA text pairs (≥ 4.5:1): fg|muted|accent|ok|bad on bg or surface; on-accent on accent|ok|bad.
     --line is only for borders, never for text. */
  --fg: #1a1a1a; --muted: #5f6368; --bg: #f5f5f7; --surface: #ffffff; --line: #d2d2d7;
  --accent: #0062c4; --ok: #16794a; --bad: #c42b1c; --on-accent: #ffffff;
  --font: "Geist", ui-sans-serif, sans-serif;
}
body { margin: 0; font-family: var(--font); color: var(--fg); background: var(--bg); }
