<style>
  .top { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); padding: var(--space-3) var(--space-5); }
  .brand { font-weight: 650; text-decoration: none; color: var(--fg); }
  nav { display: flex; gap: var(--space-4); }
  nav a { text-decoration: none; color: var(--muted); }
  nav a:hover { color: var(--fg); }
