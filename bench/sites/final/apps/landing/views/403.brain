<meta props="reason:str=''">
<meta seo title="Access denied" description="You do not have permission to open this page. The reason is shown below; ask an administrator for access." robots="noindex">

<main class="page">
  <h1>Access denied</h1>
  <p>Missing permission: <strong>{reason || 'not specified'}</strong></p>
  <p><a href="/">Back to the home page</a></p>
</main>

<style>
  .page { max-width: 60ch; margin: 0 auto; padding: var(--space-6) var(--space-4); display: grid; gap: var(--space-3); text-align: center; }
</style>
