    { href: '/settings', label: 'Settings' },
  ]
</script>

<div class="shell">
  <aside class="side">
    <p class="brand">Nubo Admin</p>
    <nav aria-label="Main">
      {#each links as l (l.href)}
        <a href={l.href} aria-current={r.path === l.href ? 'page' : undefined} class:active={r.path === l.href}>{l.label}</a>
      {/each}
    </nav>
  </aside>
  <div class="content"><slot /></div>
</div>

<style>
