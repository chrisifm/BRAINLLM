<meta seo title="About the polyglot probe" description="Why this probe exists: it checks pages per locale, the right-to-left layout and how dictionaries load in a BRAINLLM site.">
<meta route es="/es/about-us" ar="/ar/about-us">

<main class="page">
  <h1>{t('about.title')}</h1>
  <p>{t('about.body')}</p>
</main>

<style>
  .page { max-width: 68ch; margin-inline: auto; padding-block: var(--space-6); padding-inline: var(--space-4); display: grid; gap: var(--space-4); text-align: start; }
  p { margin: 0; color: var(--muted); }
</style>
