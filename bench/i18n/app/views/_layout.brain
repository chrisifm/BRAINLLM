<script>
  // the same page in every locale (brain-i18n alternates); <LangSwitch> from the kit does not build yet (see README)
  const langs = alternates()
</script>
<div class="shell">
  <header class="top">
    <a class="brand" href={t('nav.home_href')}>{t('site.brand')}</a>
    <nav aria-label="Main">
      <a href={t('nav.home_href')}>{t('nav.home')}</a>
      <a href={t('nav.about_href')}>{t('nav.about')}</a>
      <a href={t('nav.counter_href')}>{t('nav.counter')}</a>
    </nav>
    <ul class="langs" aria-label={t('nav.languages')}>
      {#each langs as l (l.locale)}
        <li><a href={l.href} hreflang={l.locale} lang={l.locale} aria-current={l.current ? 'page' : null}>{l.name}</a></li>
      {/each}
    </ul>
  </header>
  <slot />
</div>

<style>
  .shell { display: grid; gap: var(--space-2); }
  .top { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); padding-block: var(--space-3); padding-inline: var(--space-5); }
