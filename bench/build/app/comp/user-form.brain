<meta props="user:obj? busy:bool=false" emits="save:obj cancel">

<script>
  let name = sig(user ? user.name : '')
  let email = sig(user ? user.email : '')
  let active = sig(user ? user.active : true)

  let valid = drv(() => name.trim() !== '' && email.includes('@'))

  const save = () => {
    if (!valid || busy) return
    emit('save', { id: user ? user.id : null, name: name.trim(), email: email.trim(), active })
  }
</script>

<form on:submit={save}>
  <label>Name <input bind:value={name} /></label>
  <label>Email <input type="email" bind:value={email} /></label>
  <label><input type="checkbox" bind:checked={active} /> Active</label>
  <button disabled={!valid || busy}>{busy ? 'Saving…' : 'Save'}</button>
  <button type="button" on:click={emit('cancel')}>Cancel</button>
</form>

<style>
  form { display: grid; gap: var(--space-2); }
</style>
