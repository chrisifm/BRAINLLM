<meta seo title="Prerender" description="The innermost component fails while this static page is prerendered by the build; healing it and pressing Retry brings it back." canonical="/pre">
<script>
  import Controls from '../comp/controls.brain'
  import Outer from '../comp/outer.brain'
  import Sibling from '../comp/sibling.brain'
  let n = sig(0)
</script>
<main class="page">
  <h1>Prerender</h1>
  <Controls />
  <button type="button" data-p="view-inc" on:click={n++}>view {n}</button>
  <Outer ssr={true} />
  <Sibling name="view-sib" />
  <p><a data-p="nav-about" href="/about">About</a></p>
</main>
<style>
  .page { max-width: 80ch; margin: 0 auto; padding: var(--space-4); display: grid; gap: var(--space-3); }
</style>
