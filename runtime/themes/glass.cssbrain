/* BRAINLLM theme — white glass (the starter theme). Written by `brain theme glass`; tokens are the only source of color and spacing. */
:root {
  color-scheme: light;
  --space-1: 4px; --space-2: 8px; --space-3: 12px; --space-4: 16px; --space-5: 24px; --space-6: 32px;
  --radius: 14px; --radius-sm: 10px; --radius-lg: 20px;
  /* AA text pairs (>= 4.5:1, verified by runtime/test/themes.test.js): fg|muted|accent|ok|bad on bg or surface;
     on-accent on accent|ok|bad. --line is for borders only, never for text. --scrim is the backdrop of modals. */
  --fg: #1d1d1f; --muted: #55595e; --bg: #f5f5f7; --surface: #ffffff; --line: #d2d2d7;
  --scrim: rgb(15 23 42 / .45);
  --accent: #0062c4; --ok: #16794a; --bad: #c42b1c; --on-accent: #ffffff;
  --font: "Geist", "SF Pro Text", ui-sans-serif, sans-serif;
  --glass: rgba(255, 255, 255, .72); --glass-edge: rgba(255, 255, 255, .9);
  --shadow: 0 1px 2px rgba(0, 0, 0, .04), 0 12px 32px -12px rgba(0, 0, 0, .14);
}
@layer reset {
  *, *::before, *::after { box-sizing: border-box; }
  body {
    margin: 0; min-height: 100vh; font-family: var(--font); color: var(--fg); line-height: 1.5;
    -webkit-font-smoothing: antialiased; font-variant-numeric: tabular-nums;
    background:
      radial-gradient(1100px 600px at 12% -10%, #ffffff, transparent 60%),
      radial-gradient(900px 600px at 110% 10%, rgba(0, 0, 0, .035), transparent 60%),
      var(--bg);
    background-attachment: fixed;
  }
  h1, h2, h3 { line-height: 1.1; letter-spacing: -.02em; margin: 0; }
  a { color: var(--accent); }
  button, input, textarea, select { font: inherit; color: inherit; }
  button {
    border: 1px solid var(--line); background: var(--surface); border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-4); cursor: pointer;
  }
  input, textarea, select {
    border: 1px solid var(--line); background: var(--surface); border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3);
  }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  @media (prefers-reduced-motion: no-preference) { button { transition: transform .15s ease; } button:active { transform: scale(.98); } }
}
