<meta props="label:str value:str~ type:str='text' name:str? placeholder:str? autocomplete:str? required:bool=false disabled:bool=false error:str? help:str?">
<Field label={label} error={error} help={help}>
  <input
    type={type}
    name={name}
    placeholder={placeholder}
    autocomplete={autocomplete}
    required={required}
    disabled={disabled}
    aria-label={label}
    bind:value={value}
  >
</Field>
<style>
  input {
    width: 100%; min-height: 40px; padding: var(--space-2) var(--space-3);
    font: 15px/1.4 var(--font); color: var(--fg); background: var(--surface);
    border: 1px solid var(--line); border-radius: var(--radius-sm);
  }
  input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  input[aria-invalid='true'] { border-color: var(--bad); }
  input:disabled { color: var(--muted); }
</style>
