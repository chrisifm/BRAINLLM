<meta props="error:any retry:fn? login:str='/login'">
<script>
  // One message and one action per error kind (INTERNALS §40.2), for {:catch e} and failed resources. Offline and
  // network errors retry by themselves when the connection comes back; 429 retries after its Retry-After. A cancelled
  // request (kind 'aborted') shows nothing.
  // Texts (§37): the app's dictionary wins when it has the key (`"error_state.offline": "…"` in i18n/<locale>.json),
  // else the English default. The table is read directly (globalThis.__brainDict, filled by brain-i18n.js `add`), like
  // the form.* messages, so a single-language page does not load brain-i18n.js.
  // Keys: error_state.offline network timeout schema unauthorized forbidden not_found invalid rate_limited ({n}) server
  // sign_in retry reference ({id}).
  const say = (key, en, vars) => {
    const D = globalThis.__brainDict, G = globalThis, h = G.document && G.document.documentElement
    const loc = globalThis.__brainLocale || (h && h.getAttribute('lang')) || 'en'
    const def = (h && h.getAttribute('data-default-lang')) || 'en'
    const m = D && ((D[loc] && D[loc]['error_state.' + key]) ?? (D[def] && D[def]['error_state.' + key]))
    const s = typeof m === 'string' ? m : en
    return vars ? s.replace(/\{(\w+)\}/g, (x, k) => (k in vars ? String(vars[k]) : x)) : s
  }
  const text = (e) => {
    if (!e) return ''
    if (e.kind === 'offline') return say('offline', 'You are offline.')
    if (e.kind === 'network') return say('network', 'The connection was lost.')
    if (e.kind === 'timeout') return say('timeout', 'The server took too long to answer.')
    if (e.kind === 'schema') return say('schema', 'The server sent something unexpected.')
    if (e.status === 401) return say('unauthorized', 'Sign in to continue.')
    if (e.status === 403) return say('forbidden', 'You do not have permission to see this.')
    if (e.status === 404) return say('not_found', 'Not found.')
    if (e.status === 422) return say('invalid', 'Check the highlighted fields.')
    if (e.status === 429) return say('rate_limited', 'Too many requests. Trying again in {n} seconds.', { n: e.retryAfter || 30 })
    return say('server', 'Something went wrong on our side.')
  }
  const canRetry = (e) => !!retry && !!e && (e.kind !== 'http' || e.status >= 500)
  const signIn = () => login + (globalThis.location ? '?next=' + encodeURIComponent(location.pathname + location.search) : '')
  fx(() => {
    if (!retry || !error || (error.kind !== 'offline' && error.kind !== 'network') || !globalThis.addEventListener) return // no window events while the server renders
    const again = () => retry()
    globalThis.addEventListener('online', again)
    return () => globalThis.removeEventListener('online', again)
  })
  fx(() => {
    if (!retry || !error || error.status !== 429) return
    const t = setTimeout(() => retry(), (error.retryAfter || 30) * 1000)
    return () => clearTimeout(t)
  })
</script>
{#if error && error.kind !== 'aborted'}
<div class="error-state" role="alert">
  <p>{text(error)}</p>
  {#if error && error.status === 401}<a href={signIn()}>{say('sign_in', 'Sign in')}</a>{/if}
  {#if canRetry(error)}<button type="button" on:click={retry()}>{say('retry', 'Retry')}</button>{/if}
  {#if error && error.id && error.status >= 500}<small>{say('reference', 'Reference: {id}', { id: error.id })}</small>{/if}
</div>
{/if}
<style>
  .error-state {
    display: grid; justify-items: start; gap: var(--space-2); padding: var(--space-4); font: 14px/1.5 var(--font);
    color: var(--fg); background: var(--glass); border: 1px solid var(--glass-edge); border-radius: var(--radius);
  }
  p { margin: 0; }
  a { color: var(--accent); }
  button {
    font: inherit; padding: var(--space-1) var(--space-3); border: 1px solid var(--line); border-radius: var(--radius-sm);
    color: var(--fg); background: var(--surface); cursor: pointer;
  }
  small { color: var(--muted); }
</style>
