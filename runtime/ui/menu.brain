<meta props="label:str items:list" emits="select:obj">
<script>
  // items: [{ id: 'edit', label: 'Edit', disabled?: true }]
  let open = sig(false)
  let pop = ref()
  let btn = ref()
  const enabled = () => [...pop.querySelectorAll('[role=menuitem]:not([disabled])')]
  const choose = (it) => {
    open = false
    btn.focus()
    emit('select', it)
  }
  const keys = (e) => {
    const all = enabled()
    const i = all.indexOf(e.target)
    if (e.key === 'Escape') {
      open = false
      btn.focus()
    } else if (e.key === 'ArrowDown' && all.length) {
      e.preventDefault()
      all[(i + 1) % all.length].focus()
    } else if (e.key === 'ArrowUp' && all.length) {
      e.preventDefault()
      all[(i - 1 + all.length) % all.length].focus()
    }
  }
  fx(() => {
    if (!open || !pop) return
    // next frame: the popup is visible (hidden removed) only after this update is painted
    const h = requestAnimationFrame(() => {
      const all = enabled()
      if (all.length) all[0].focus()
    })
    const out = (e) => {
      if (!pop.contains(e.target) && !btn.contains(e.target)) open = false
    }
    pop.ownerDocument.addEventListener('pointerdown', out)
    return () => {
      cancelAnimationFrame(h)
      pop.ownerDocument.removeEventListener('pointerdown', out)
    }
  })
</script>
<div class="menu">
  <button type="button" bind:ref={btn} aria-haspopup="menu" aria-expanded={open ? 'true' : 'false'} on:click={open = !open}>{label}</button>
  <div class="pop" role="menu" aria-label={label} bind:ref={pop} hidden={!open} on:keydown={keys}>
    {#each items as it (it.id)}
      <button type="button" role="menuitem" tabindex="-1" disabled={it.disabled} on:click={choose(it)}>{it.label}</button>
    {/each}
  </div>
</div>
<style>
  .menu { position: relative; display: inline-block; }
  .menu > button { font: 600 14px/1.2 var(--font); padding: var(--space-2) var(--space-3); border: 1px solid var(--glass-edge); border-radius: var(--radius-sm); color: var(--fg); background: var(--glass); cursor: pointer; }
  .pop {
    position: absolute; top: calc(100% + 6px); left: 0; min-width: 180px; display: grid; padding: var(--space-1); z-index: 50;
    border: 1px solid var(--glass-edge); border-radius: var(--radius); background: var(--glass); box-shadow: var(--shadow); backdrop-filter: blur(20px) saturate(1.4);
  }
  .pop[hidden] { display: none; }
  [role=menuitem] { text-align: left; font: 14px/1.3 var(--font); padding: var(--space-2) var(--space-3); border: 0; border-radius: var(--radius-sm); color: var(--fg); background: transparent; cursor: pointer; }
  [role=menuitem]:hover, [role=menuitem]:focus-visible { background: var(--surface); outline: none; }
  [role=menuitem]:disabled { color: var(--muted); cursor: not-allowed; }
  button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
