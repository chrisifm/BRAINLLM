<meta props="rows:list columns:list caption:str rowKey:str='id' sortable:bool=true loading:bool=false error:str? empty:str='No data yet.' rowHeight:num=40 height:num=480">
<script>
  // columns: [{ key: 'name', label: 'Name', sort?: false }] · more than 200 rows → only the visible window is rendered
  const VIRTUAL_FROM = 200
  const OVERSCAN = 10
  let sortKey = sig('')
  let dir = sig(1)
  let top = sig(0)
  const sorted = drv(() => {
    if (!sortKey) return rows
    const k = sortKey
    const d = dir
    return [...rows].sort((a, b) => (a[k] > b[k] ? d : a[k] < b[k] ? -d : 0))
  })
  const virtual = drv(() => sorted.length > VIRTUAL_FROM)
  const first = drv(() => (virtual ? Math.max(0, Math.floor(top / rowHeight) - OVERSCAN) : 0))
  const last = drv(() => (virtual ? Math.min(sorted.length, first + Math.ceil(height / rowHeight) + 2 * OVERSCAN) : sorted.length))
  const visible = drv(() => sorted.slice(first, last))
  const sortBy = (k) => {
    if (sortKey === k) dir = -dir
    else { sortKey = k; dir = 1 }
  }
  const ariaSort = (k) => (sortKey === k ? (dir === 1 ? 'ascending' : 'descending') : 'none')
  const arrow = (k) => (sortKey === k ? (dir === 1 ? '▲' : '▼') : '')
  const onScroll = (e) => { top = e.target.scrollTop }
</script>
<div class="wrap" class:virtual={virtual} style:max-height={virtual ? height + 'px' : null} on:scroll={onScroll}>
  <table aria-busy={loading ? 'true' : null} aria-rowcount={sorted.length + 1}>
    <caption>{caption}</caption>
    <thead>
      <tr>
        {#each columns as c (c.key)}
          <th scope="col" aria-sort={ariaSort(c.key)}>
            {#if sortable && c.sort !== false}
              <button type="button" on:click={sortBy(c.key)}>{c.label} <span aria-hidden="true">{arrow(c.key)}</span></button>
            {:else}
              {c.label}
            {/if}
          </th>
        {/each}
      </tr>
    </thead>
    <tbody>
      {#if error}
        <tr><td class="msg bad" colspan={columns.length} role="alert">{error}</td></tr>
      {:else if loading}
        <tr><td class="msg" colspan={columns.length}>Loading…</td></tr>
      {:else}
        {#if first > 0}<tr class="pad" aria-hidden="true" style:height={first * rowHeight + 'px'}></tr>{/if}
        {#each visible as r (r[rowKey])}
          <tr style:height={rowHeight + 'px'}>
            {#each columns as c (c.key)}<td>{r[c.key]}</td>{/each}
          </tr>
        {:empty}
          <tr><td class="msg" colspan={columns.length}>{empty}</td></tr>
        {/each}
        {#if last < sorted.length}<tr class="pad" aria-hidden="true" style:height={(sorted.length - last) * rowHeight + 'px'}></tr>{/if}
      {/if}
    </tbody>
  </table>
</div>
<style>
  .wrap { overflow: auto; border: 1px solid var(--glass-edge); border-radius: var(--radius); background: var(--glass); box-shadow: var(--shadow); }
  table { width: 100%; border-collapse: collapse; font: 14px/1.4 var(--font); color: var(--fg); font-variant-numeric: tabular-nums; }
  caption { text-align: left; font-weight: 650; padding: var(--space-3) var(--space-3) var(--space-2); }
  th, td { text-align: left; padding: var(--space-2) var(--space-3); border-bottom: 1px solid var(--line); }
  thead th { position: sticky; top: 0; background: var(--surface); font-weight: 600; color: var(--muted); }
  th button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  th button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .msg { text-align: center; color: var(--muted); padding: var(--space-5); }
  .msg.bad { color: var(--bad); }
  .pad td { padding: 0; border: 0; }
</style>
