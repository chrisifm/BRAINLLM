<meta props="label:str checked:bool~ name:str? disabled:bool=false error:str?">
<div class="check">
  <label>
    <input type="checkbox" name={name} disabled={disabled} aria-invalid={error ? 'true' : null} bind:checked={checked}>
    <span>{label}</span>
  </label>
  {#if error}<p class="error" role="alert">{error}</p>{/if}
</div>
<style>
  label { display: inline-flex; align-items: center; gap: var(--space-2); font: 15px/1.4 var(--font); color: var(--fg); cursor: pointer; }
  input { width: 18px; height: 18px; accent-color: var(--accent); }
  .error { font-size: 13px; color: var(--bad); margin: var(--space-1) 0 0; }
</style>
