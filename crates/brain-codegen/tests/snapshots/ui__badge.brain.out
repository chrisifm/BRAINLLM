import { tpl, insert, attr } from "/@brain/brain.js";
const $t0 = tpl("<span data-b=\"dxj2kp\" class=\"badge\"><!></span>");
function Badge($p = {}) {
  const $r3 = $t0();
  const $e1 = $r3;
  const $e2 = $r3.firstChild;
  attr($e1, "data-tone", () => ($p.tone ?? 'neutral'));
  insert(null, () => $p.text, $e2);
