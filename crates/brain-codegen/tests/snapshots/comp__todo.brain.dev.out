/* ---- css ---- */
@layer comp {
  @scope ([data-b="lxd7ly"]) to ([data-b]) {
    :where(:scope):is(.todo), .todo {
      display: grid;
      gap: var(--space-2);
    }
    :where(:scope):is(form), form {
      display: flex;
      gap: var(--space-1);
    }
    :where(:scope):is(li), li {
      display: flex;
      gap: var(--space-2);
      align-items: center;
      &.done span {
        text-decoration: line-through;
        color: var(--muted);
      }
    }
    :where(:scope):is(.empty), .empty {
      color: var(--muted);
    }
    :where(:scope):is(footer) button.on, footer button.on {
      color: var(--accent);
    }
  }
}
