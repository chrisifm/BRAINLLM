/* ---- css ---- */
@layer view {
  @scope ([data-b="0m3tc1"]) to ([data-b]) {
    :where(:scope):is(.dash), .dash {
      display: grid;
      gap: var(--space-3);
      padding: var(--space-3);
      background: var(--bg);
      color: var(--fg);
    }
    :where(:scope):is(header), header {
      display: flex;
      gap: var(--space-2);
      align-items: center;
    }
    :where(:scope):is(.error), .error {
      color: var(--bad);
    }
    :where(:scope):is(table), table {
      width: 100%;
      border-collapse: collapse;
    }
    :where(:scope):is(td), td, :where(:scope):is(th), th {
      padding: var(--space-1) var(--space-2);
      text-align: left;
    }
  }
}
@layer ui {
  @scope ([data-b="dxj2kp"]) to ([data-b]) {
    :where(:scope):is(.badge), .badge {
      padding: 0 var(--space-1);
      border-radius: var(--radius);
      color: var(--muted);
      &[data-tone=ok] {
        color: var(--ok);
      }
      &[data-tone=bad] {
        color: var(--bad);
      }
    }
  }
}

