{
  "id": "session-secrets",
  "kind": "capability",
  "title": "Encrypted session secrets and key rotation",
  "why": "Server-only tokens stop living in a readable signed cookie, and keys rotate without signing everyone out.",
  "changelog": [
    "`ctx.session.setSecret` stores server-only values encrypted"
  ],
  "guide": "docs/NATIVE-AUTH-SSR.md",
  "codes": [
    "B0737"
  ],
  "apis": [
    "ctx.session.setSecret",
    "ctx.session.secret",
    "ctx.session.clearSecret",
    "BRAIN_SECRET_PREVIOUS",
    "BRAIN_SESSION_VERSION",
    "BRAIN_SESSION_SECONDS"
  ],
  "affects": [
    ".brain_env",
    "server/**/*.jsbrain"
  ],
  "adopt": {
    "file": "server/auth.jsbrain",
    "snippet": "ctx.session.setSecret(token, { maxAge: 3600 })"
  },
  "uses": [
    {
      "glob": "**/*.{brain,jsbrain}",
      "contains": "ctx.session.setSecret"
    }
  ]
}
