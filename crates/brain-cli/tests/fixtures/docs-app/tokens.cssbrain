:root {
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 16px;
  --space-4: 24px;
  --space-5: 32px;
  --space-6: 48px;
  --radius: 8px;
  --radius-sm: 6px;
  --radius-lg: 14px;
  --fg: #1a1a1a;
  --muted: #6b7280;
  --bg: #f5f5f7;
  --surface: #ffffff;
  --line: #d2d2d7;
  --scrim: rgb(15 23 42 / .45);
  --accent: #0071e3;
  --on-accent: #ffffff;
  --ok: #1a7f37;
  --bad: #d1242f;
  --font: "Geist", "SF Pro Text", ui-sans-serif, sans-serif;
}
