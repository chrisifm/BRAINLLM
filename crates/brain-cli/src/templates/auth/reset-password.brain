<meta seo title="Reset password" description="Request a single-use password recovery link." robots="noindex">
<script>
  import Input from '../ui/input.brain'
  import Button from '../ui/button.brain'
  const request = api('/_brain/auth/password/request', { post: {} })
  const reset = api('/_brain/auth/password/reset', { post: {} })
  let token = ''
  let hasToken = sig(false)
  let sent = sig(false)
  let complete = sig(false)
  mounted(() => {
    const candidate = new URLSearchParams(location.hash.slice(1)).get('token') ?? ''
    if (/^[a-f0-9]{64}$/.test(candidate)) { token = candidate; hasToken = true }
    history.replaceState(null, '', location.pathname + location.search)
  })
  let ask = form({ email: 'email!' }, { submit: async (v) => {
    await request.post(v)
    sent = true
    ask.reset()
  } })
  let change = form({ password: 'str!>=12', repeat: 'str!>=12' }, { submit: async (v) => {
    if (v.password !== v.repeat) throw { errors: { repeat: 'Passwords must match.' } }
    await reset.post({ token, password: v.password })
    token = ''
    change.reset()
    complete = true
  } })
</script>
<main class="page">
  <h1>Reset password</h1>
  {#if complete}
    <p role="status">Password changed. Your previous sessions have been signed out.</p>
    <a href="/login">Sign in with your new password</a>
  {:else if hasToken}
    <form on:submit={change.submit}>
      <Input label="New password" name="password" type="password" autocomplete="new-password" bind:value={change.v.password} error={change.err.password} disabled={change.busy} />
      <Input label="Repeat new password" name="repeat" type="password" autocomplete="new-password" bind:value={change.v.repeat} error={change.err.repeat} disabled={change.busy} />
      {#if change.error}<p role="alert">{change.error}</p>{/if}
      <Button type="submit" busy={change.busy}>Change password</Button>
    </form>
  {:else}
    {#if sent}<p role="status">Request accepted. If your account is eligible and email delivery is available, check your inbox and spam folder for a link.</p>{/if}
    <form on:submit={ask.submit}>
      <Input label="Account email" name="email" type="email" autocomplete="email" bind:value={ask.v.email} error={ask.err.email} disabled={ask.busy} />
      {#if ask.error}<p role="alert">{ask.error}</p>{/if}
      <Button type="submit" busy={ask.busy}>Request recovery link</Button>
    </form>
    <a href="/login">Return to sign in</a>
  {/if}
</main>
<style>
  .page { max-width: 48ch; margin: auto; padding: var(--space-4); display: grid; gap: var(--space-3); }
  form { display: grid; gap: var(--space-3); }
</style>
