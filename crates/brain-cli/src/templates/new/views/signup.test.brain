<script>
  import Signup from './signup.brain'

  test('an empty form shows the validation errors without calling the server', async () => {
    await mount(Signup, { configured: true })
    await click('button[type=submit]')
    expect(count('.err')).toBe(2)
  })

  test('without a backend there is no form, only the notice', async () => {
    await mount(Signup, { configured: false })
    expect(count('form')).toBe(0)
    expect(text('[role=status]').includes('not connected')).toBeTruthy()
  })
</script>
