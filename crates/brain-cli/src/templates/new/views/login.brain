<meta seo keyword="sign in" title="Sign in" description="Sign in to your account. In development the demo password lives in .brain_env; production uses your real provider.">

<script>
  import auth from '../server/auth.jsbrain'
  import session from '../channels/session.jsbrain'
  import Button from '../ui/button.brain'

  export async function load(ctx) {
    const native = Boolean(ctx.backend)
    return { configured: native || auth.configured(), native }
  }
  server: async function login(ctx, v, requestedNext) {
    const result = ctx.backend ? await ctx.backend.login(v) : null
    if (!ctx.backend && process.env.BRAIN_BACKEND_URL) throw { status: 503 }
    const user = result ? result.user : auth.check(v.email, v.password)
    if (!user) throw { errors: { password: 'Wrong email or password' } }
    if (!ctx.backend) ctx.session.set(user)
    // One server-side redirect decision covers JavaScript and progressive form posts.
    const candidate = requestedNext ?? ctx.query.next ?? ''
    const next = typeof candidate === 'string' && candidate.length <= 8192 && /^\/(?![\/\\])[^\\\x00-\x20\x7f]*$/.test(candidate) && !/^\/%2f/i.test(candidate) && !/%(?:0[0-9a-f]|1[0-9a-f]|5c|7f)/i.test(candidate) && !/%20/i.test(candidate.split(/[?#]/)[0]) ? candidate : '/account'
    return { redirect: next, user }
  }
  let f = form({ email: 'email!', password: 'str!' }, {
    submit: async (v) => {
      const r = await login(v, new URLSearchParams(location.search).get('next'))
      session.user = r.user
      f.reset()
      navigate(r.redirect)
    },
  })
</script>

<main class="page">
  <h1>Sign in</h1>
  {#if props.configured}
    <form on:submit={f.submit}>
      <label>Email <input type="email" autocomplete="email" bind:value={f.v.email} disabled={f.busy}></label>
      {#if f.err.email}<p class="err">{f.err.email}</p>{/if}
      <label>Password <input type="password" autocomplete="current-password" bind:value={f.v.password} disabled={f.busy}></label>
      {#if f.err.password}<p class="err">{f.err.password}</p>{/if}
      {#if f.error}<p role="alert">{f.error}</p>{/if}
      <Button type="submit" busy={f.busy}>Sign in</Button>
    </form>
  {:else}
    <p role="status">Authentication is not configured. Connect the native backend with BRAIN_BACKEND_URL, or configure a real provider in server/auth.jsbrain. The demo exists only in development.</p>
  {/if}
</main>

<style>
  .page { max-width: 40ch; margin: 0 auto; padding: var(--space-6) var(--space-4); display: grid; gap: var(--space-3); }
  form { display: grid; gap: var(--space-3); }
  label { display: grid; gap: var(--space-1); }
  .err { margin: 0; color: var(--bad); }
</style>
