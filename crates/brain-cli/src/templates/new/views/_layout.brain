<header class="top">
  <a class="brand" href="/">{{name}}</a>
  <nav aria-label="Main">
    <a href="/">Home</a>
    <a href="/about">About</a>
    <a href="/posts">Posts</a>
    <a href="/account">Account</a>
  </nav>
</header>
<div class="shell">
  <p class="who" aria-live="polite">
    {#if session.user}Signed in as {session.user.email}{:else}<a href="/login">Sign in</a>{/if}
  </p>
  <slot />
</div>

<style>
  .top { display: flex; flex-direction: column; align-items: stretch; gap: var(--space-2); padding: max(var(--space-3), env(safe-area-inset-top)) max(var(--space-4), env(safe-area-inset-right)) var(--space-3) max(var(--space-4), env(safe-area-inset-left)); min-width: 0; }
  .brand { font-weight: 650; text-decoration: none; color: var(--fg); }
  nav { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); min-width: 0; }
  nav a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; color: var(--muted); }
  nav a:hover, nav a[aria-current="page"] { color: var(--fg); }
  @media (min-width: 42rem) { .top { flex-direction: row; align-items: center; justify-content: space-between; } }
  @media (min-width: 64rem) { .top { padding-inline: max(var(--space-6), env(safe-area-inset-left)); } }
  .shell { display: grid; gap: var(--space-2); }
  .who { margin: 0; padding: 0 var(--space-5); text-align: right; color: var(--muted); font-size: .9rem; }
</style>
