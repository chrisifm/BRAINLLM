<meta server>
// Native mode never falls back to this demo, including during a backend failure.
// The framework marks its development sidecar explicitly; production cannot enable a demo with a password alone.
const configured = () => process.env.NODE_ENV === 'development' && !process.env.BRAIN_BACKEND_URL && Boolean(process.env.DEMO_PASSWORD)

export default {
  configured,
  check: (email, password) => configured() && password === process.env.DEMO_PASSWORD ? { email } : null,
}
