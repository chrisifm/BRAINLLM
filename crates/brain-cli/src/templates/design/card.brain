<meta props="title:str?">
<article class="card">
  {#if title}<h2>{title}</h2>{/if}
  <div class="body"><slot /></div>
  <footer><slot name="footer" /></footer>
</article>
<style>
  .card { display: grid; gap: var(--space-3); padding: var(--space-4); min-width: 0; border: 1px solid var(--line); border-radius: var(--radius-lg); color: var(--fg); background: var(--surface); }
  h2 { font: 650 1.125rem/1.3 var(--font); margin: 0; overflow-wrap: anywhere; }
  .body { min-width: 0; overflow-wrap: anywhere; }
  footer { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  footer:empty { display: none; }
</style>
