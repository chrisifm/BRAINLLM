<meta seo title="Problems" description="Every diagnostic of the whole project, grouped by family and by component.">
<script>
  // the dev server's `brain check --json` of the whole project: [{ code, file, line, col, msg, fix, level }]
  const src = (globalThis.location && new URLSearchParams(location.search).get('src')) || ''
  const problems = api(src + '/@brain/problems', { get: {} })
  let by = sig('family')
  // the dev server sends `family` ('B13xx') and `component`; the names follow the catalog's families
  const FAMILY = { '00': 'Syntax', '01': 'Scope', '02': 'Markup', '03': 'Style', '04': 'Accessibility', '05': 'SEO', '06': 'Memory', '07': 'Server', '08': 'Channels', '09': 'Loops', '10': 'Dead code', '11': 'Data', '12': 'Compatibility', '13': 'Practices', '16': 'Metadata', '17': 'Agent tools' }
  const family = (p) => {
    const d = String(p.family || p.code).slice(1, 3)
    return (FAMILY[d] || 'Other') + ' · B' + d + 'xx'
  }
  const groups = (list, mode) => {
    const g = {}
    for (const p of list) (g[mode === 'family' ? family(p) : p.component || p.file] ||= []).push(p)
    return Object.entries(g).sort((a, b) => b[1].length - a[1].length)
  }
  const data = resource(problems.get, { every: '3s' })
</script>
<h1>Problems</h1>
<div class="seg" role="group" aria-label="Group by">
  <button type="button" aria-pressed={by === 'family'} on:click={by = 'family'}>By family</button>
  <button type="button" aria-pressed={by === 'file'} on:click={by = 'file'}>By component</button>
</div>
{#await data}
  <p class="muted">Checking the project…</p>
{:then list}
  {#each groups(list, by) as g (g[0])}
      <section class="group">
        <h2>{g[0]} <span class="n">{g[1].length}</span></h2>
        <ul>
          {#each g[1] as p, i (i)}
            <li class:err={p.level === 'error'}><code>{p.code}</code> {p.file}:{p.line} — {p.msg}{#if p.fix}<br><small>fix: {p.fix}</small>{/if}</li>
          {:empty}
            <li class="muted">None.</li>
          {/each}
        </ul>
      </section>
  {:empty}
    <p class="muted">No problems: brain check finds nothing in this project.</p>
  {/each}
{:catch e}
  <ErrorState error={e} retry={data.refetch} />
{/await}
<style>
  h1 { margin: 0 0 var(--space-4); font-size: 22px; }
  h2 { margin: 0 0 var(--space-2); font-size: 15px; }
  .seg { display: flex; gap: var(--space-1); margin-bottom: var(--space-4); }
  .seg button { padding: var(--space-1) var(--space-3); border-radius: var(--radius-sm); border: 1px solid var(--line); background: var(--surface); cursor: pointer; }
  .seg button[aria-pressed='true'] { color: var(--on-accent); background: var(--accent); border-color: var(--accent); }
  .group { margin-bottom: var(--space-4); padding: var(--space-4); border-radius: var(--radius); border: 1px solid var(--glass-edge); background: var(--glass); box-shadow: var(--shadow); }
  ul { margin: 0; padding-left: var(--space-4); font-size: 14px; }
  li { margin: var(--space-1) 0; }
  li.err code { color: var(--bad); }
  small, .muted { color: var(--muted); }
  .n { font-size: 12px; color: var(--muted); font-weight: 400; }
</style>
