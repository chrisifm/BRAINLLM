<script>
  import Todo from './todo.brain'

  test('an empty list shows the empty state', async () => {
    await mount(Todo, {})
    expect(text('li.empty')).toBe('Nothing here.')
  })

  test('adds, completes and filters tasks', async () => {
    await mount(Todo, {})
    await type('input[aria-label="New task"]', 'Buy bread')
    await click('form button')
    await type('input[aria-label="New task"]', 'Pay the power bill')
    await click('form button')
    expect(count('ul li')).toBe(2)
    expect(text('footer span')).toBe('2 left')

    await click('input[aria-label="Mark Buy bread"]')
    expect(text('footer span')).toBe('1 left')

    await click('footer button:nth-of-type(3)')
    expect(count('ul li')).toBe(1)
    expect(text('ul li span')).toBe('Buy bread')
  })

  test('the Add button is disabled with empty text', async () => {
    await mount(Todo, {})
    expect(attr('form button', 'disabled')).toBe('')
    await type('input[aria-label="New task"]', '   ')
    expect(attr('form button', 'disabled')).toBe('')
  })
</script>
